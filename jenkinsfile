
pipeline {
    agent any

    tools {
        jdk 'jdk17'
        nodejs 'node23'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git 'https://github.com/anilkumarvanum9-debug/DevOps-Project-Swiggy.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        "$SCANNER_HOME/bin/sonar-scanner" \
                          -Dsonar.projectName=Swiggy \
                          -Dsonar.projectKey=Swiggy
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('OWASP FS Scan') {
            steps {
                dependencyCheck(
                    additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                    odcInstallation: 'DP-Check'
                )
                dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '/usr/bin/trivy fs . > trivyfs.txt'
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "$DOCKER_PASS" | /usr/bin/docker login \
                          -u "$DOCKER_USER" --password-stdin

                        /usr/bin/docker build -t anil1438/swiggy:latest .
                        /usr/bin/docker push anil1438/swiggy:latest

                        /usr/bin/docker logout
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '/usr/bin/trivy image anil1438/swiggy:latest > trivy.txt'
            }
        }

        stage('Deploy to Container') {
            steps {
                sh '''
                    set -eu

                    /usr/bin/docker rm -f swiggy 2>/dev/null || true

                    /usr/bin/docker run -d \
                      --name swiggy \
                      --restart unless-stopped \
                      -p 3000:3000 \
                      anil1438/swiggy:latest

                    /usr/bin/docker ps
                '''
            }
        }
    }
}
